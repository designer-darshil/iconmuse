{
  "name": "icons-lib",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "catalog:build": "node scripts/build-icon-catalog.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "dev": "vite --host --port 5174",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "check": "oxlint && tsc -b && node scripts/check-contrast.mjs",
    "preview": "vite preview",
    "figma:data": "node figma-plugin/scripts/build-worker-data.mjs",
    "figma:build": "vite build --config figma-plugin/vite.config.ts --mode plugin-ui && vite build --config figma-plugin/vite.config.ts --mode plugin-code",
    "figma:worker:dev": "wrangler dev --config figma-plugin/worker/wrangler.toml",
    "figma:worker:deploy": "wrangler deploy --config figma-plugin/worker/wrangler.toml"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.3",
    "@dicebear/open-peeps": "^9.4.2",
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.49.0",
    "clsx": "^2.1.1",
    "feather-icons": "^4.29.2",
    "framer-motion": "^14.6.0",
    "jszip": "^3.10.2",
    "lineicons": "^1.3.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remixicon": "^4.9.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fluentui-emoji/svg": "^2.2.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/carbon": "^1.2.29",
    "@iconify-json/fluent": "^1.2.60",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify-json/mingcute": "^1.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "flowbite-svelte-illustrations": "^1.1.1",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "sass-embedded": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
